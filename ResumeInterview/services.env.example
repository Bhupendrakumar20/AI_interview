# Next.js server-side proxy URLs
NEXT_PUBLIC_RESUME_API_URL=https://your-lightweight-service.onrender.com
NEXT_PUBLIC_RESUME_ML_API_URL=https://your-ml-service.onrender.com

# Required by ML service if using Ollama-compatible generation
OLLAMA_URL=https://your-ollama-compatible-service.example.com
OLLAMA_MODEL=gemma3:4b
