```
PrepWise/
├── AIBuddyMode/                   # Python FastAPI: Adaptive AI Buddy Interview Backend
│   ├── api.py                     # Main Uvicorn server entrypoint (uses Redis for sessions)
│   ├── logic.py                   # Adaptive state progression & weak area pick algorithms
│   ├── evaluator.py               # AI evaluation & grading prompts (Gemini API)
│   └── state.py                   # InterviewState Pydantic schemas
├── ResumeInterview/               # Python FastAPI: Resume RAG & Interview Backend
│   ├── api.py                     # Main Uvicorn server (port 8000)
│   ├── resumeAnalyzer.py          # PDF Parser & Resume RAG parser
│   └── questionGeneration.py      # LLM question generator customized to resumes
├── app/                           # Next.js 16 (App Router) Frontend
│   ├── (root)/                    # Logged-in shell with responsive sidebar wrapper
│   │   ├── dashboard/             # User landing, charts, statistics & metrics
│   │   ├── interview/             # Mock test settings, runner, and custom cards
│   │   │   └── buddy/             # Lobby and live socket rooms for Buddy Mode
│   │   └── jobs/                  # Job matches & mock tests linked to jd
│   └── api/                       # Next.js API Routes
│       ├── auth/                  # Credentials signup/login & JWT controller
│       └── interview-buddy/       # Route handlers for updating active buddy rooms
├── components/                    # React UI Components
│   ├── ui/                        # Low-level UI primitives (shadcn-based)
│   ├── InterviewCard.jsx          # Individual interview summary card (displays rating/date)
│   ├── InterviewRunner.jsx        # Interview logic controller, speech-to-text, timer
│   └── ThemeToggle.jsx            # Dark/light theme toggler
├── firebase/                      # Firebase Init configurations
│   ├── admin.js                   # Node.js Firebase Admin SDK init
│   └── client.js                  # Frontend Firebase Web SDK init
├── lib/                           # Core Utilities, Actions, & Helpers
│   ├── actions/                   # Server Actions (DB reads/writes, authentication logic)
│   │   ├── auth.action.js         # JWT signing, OTP validation, passwords hashing
│   │   ├── general.action.js      # Fetching interviews, saving feedback reports
│   │   └── interview-buddy.action.js # Firestore actions for socket buddy sessions
│   ├── security/                  # Rate limiters, transactions, & proctoring hooks
│   │   ├── transaction-manager.js # Concurrency locking for Firestore rooms & stats
